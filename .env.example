# Copy this file to .env (or otherwise export these variables) before running the app.
# Never commit the real .env file.

# eodhd.com API token
EODHD_API_TOKEN=

# QuestDB
QUESTDB_PASSWORD=
# Optional overrides (defaults shown)
# QUESTDB_HOST=127.0.0.1
# QUESTDB_PG_PORT=8812
# QUESTDB_HTTP_PORT=9000
# QUESTDB_USER=admin
# QUESTDB_DB_NAME=qdb

# QuestDB for the integration tests (pytest -m integration). They drop and recreate every
# table, so these MUST point at a throwaway instance with its own data directory and ports,
# never at the one configured above; the tests refuse to run if host and port match it.
# Unset = skipped.
# QUESTDB_TEST_HOST=127.0.0.1
# QUESTDB_TEST_PG_PORT=18812
# QUESTDB_TEST_HTTP_PORT=19000
# QUESTDB_TEST_USER=admin
# QUESTDB_TEST_PASSWORD=quest
